.app {
  padding: 32rpx 30rpx 60rpx;
}

/* ---- 顶部 ---- */
.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.head-title {
  font-size: 40rpx;
  font-weight: 700;
}
.head-btn {
  font-size: 26rpx;
}
.head-tip {
  color: var(--text-dim);
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

/* ---- 错误 ---- */
.error {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(248, 113, 113, 0.12);
  border: 1rpx solid rgba(248, 113, 113, 0.4);
  border-radius: 12rpx;
  color: #fca5a5;
  font-size: 26rpx;
  line-height: 1.5;
}

/* ---- 空状态 ---- */
.empty {
  text-align: center;
  color: var(--text-dim);
  font-size: 28rpx;
  padding: 120rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* ---- 历史条目 ---- */
.item {
  background: linear-gradient(180deg, var(--card) 0%, var(--card-2) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.item-title {
  font-size: 32rpx;
  font-weight: 700;
  word-break: break-all;
}
.badge {
  display: inline-block;
  margin-left: 10rpx;
  font-size: 20rpx;
  font-weight: 400;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  vertical-align: middle;
}
.badge {
  color: var(--accent-2);
  border: 1rpx solid rgba(86, 200, 255, 0.5);
}
.badge.local {
  color: var(--text-dim);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}
.item-meta {
  color: var(--text-dim);
  font-size: 26rpx;
  margin-top: 10rpx;
}
.item-time {
  color: rgba(154, 163, 184, 0.7);
  font-size: 22rpx;
  margin-top: 6rpx;
}
.item-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}